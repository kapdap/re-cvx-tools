<local:View 
      x:TypeArguments="models:TriggerViewModel, models:TriggerViewModelEntry"
      x:Class="RDXplorer.Views.TriggerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RDXplorer.Views"
      xmlns:models="clr-namespace:RDXplorer.ViewModels"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=models:TriggerViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Triggers">
    <DataGrid AutoGenerateColumns="False"
              BorderThickness="0"
              CanUserAddRows="False"
              IsReadOnly="True"
              ItemsSource="{Binding Entries}" MouseDoubleClick="DataGrid_MouseDoubleClick">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Position" Binding="{Binding Model.Position, StringFormat=X8}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Name" Binding="{Binding TriggerType}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Flg" Binding="{Binding Model.Fields.Flg}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Type" Binding="{Binding Model.Fields.Type}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Id" Binding="{Binding Model.Fields.Id}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="FlrNo" Binding="{Binding Model.Fields.FlrNo}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Attr" Binding="{Binding Model.Fields.Attr.Value, StringFormat=X8}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Px" Binding="{Binding Model.Fields.Px}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Py" Binding="{Binding Model.Fields.Py}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Pz" Binding="{Binding Model.Fields.Pz}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="W" Binding="{Binding Model.Fields.W}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="H" Binding="{Binding Model.Fields.H}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="D" Binding="{Binding Model.Fields.D}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Prm0" Binding="{Binding Model.Fields.Prm0}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Prm1" Binding="{Binding Model.Fields.Prm1}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Prm2" Binding="{Binding Model.Fields.Prm2}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Prm3" Binding="{Binding Model.Fields.Prm3}" FontFamily="Consolas"/>
        </DataGrid.Columns>
    </DataGrid>
</local:View>
