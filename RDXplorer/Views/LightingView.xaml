<local:View 
      x:TypeArguments="models:LightingViewModel, models:LightingViewModelEntry"
      x:Class="RDXplorer.Views.LightingView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RDXplorer.Views"
      xmlns:models="clr-namespace:RDXplorer.ViewModels"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=models:LightingViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Lighting">
    <DataGrid AutoGenerateColumns="False"
              BorderThickness="0"
              CanUserAddRows="False"
              IsReadOnly="True"
              ItemsSource="{Binding Entries}" MouseDoubleClick="DataGrid_MouseDoubleClick">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Position" Binding="{Binding Model.Position, StringFormat=X8}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Name" Binding="{Binding LightingType}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Flg" Binding="{Binding Model.Fields.Flg.Value, StringFormat=X8}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Type" Binding="{Binding Model.Fields.Type}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Aspd" Binding="{Binding Model.Fields.Aspd}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="LkFlg" Binding="{Binding Model.Fields.LkFlg}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="LkNo" Binding="{Binding Model.Fields.LkNo}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="LkOno" Binding="{Binding Model.Fields.LkOno}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Lsrc" Binding="{Binding Model.Fields.Lsrc}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Px" Binding="{Binding Model.Fields.Px}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Py" Binding="{Binding Model.Fields.Py}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Pz" Binding="{Binding Model.Fields.Pz}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Lx" Binding="{Binding Model.Fields.Lx}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Ly" Binding="{Binding Model.Fields.Ly}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Lz" Binding="{Binding Model.Fields.Lz}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Vx" Binding="{Binding Model.Fields.Vx}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Vy" Binding="{Binding Model.Fields.Vy}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Vz" Binding="{Binding Model.Fields.Vz}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Spc" Binding="{Binding Model.Fields.Spc}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Dif" Binding="{Binding Model.Fields.Dif}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Amb" Binding="{Binding Model.Fields.Amb}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="R" Binding="{Binding Model.Fields.R}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="G" Binding="{Binding Model.Fields.G}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="B" Binding="{Binding Model.Fields.B}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Nr" Binding="{Binding Model.Fields.Nr}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Fr" Binding="{Binding Model.Fields.Fr}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Iang" Binding="{Binding Model.Fields.Iang}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Oang" Binding="{Binding Model.Fields.Oang}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Ax" Binding="{Binding Model.Fields.Ax}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Ay" Binding="{Binding Model.Fields.Ay}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Az" Binding="{Binding Model.Fields.Az}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Mode" Binding="{Binding Model.Fields.Mode}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Ct0" Binding="{Binding Model.Fields.Ct0}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Ct1" Binding="{Binding Model.Fields.Ct1}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Ct2" Binding="{Binding Model.Fields.Ct2}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Ct3" Binding="{Binding Model.Fields.Ct3}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wpx" Binding="{Binding Model.Fields.Wpx}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wpy" Binding="{Binding Model.Fields.Wpy}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wpz" Binding="{Binding Model.Fields.Wpz}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wvx" Binding="{Binding Model.Fields.Wvx}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wvy" Binding="{Binding Model.Fields.Wvy}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wvz" Binding="{Binding Model.Fields.Wvz}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wspc" Binding="{Binding Model.Fields.Wspc}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wdif" Binding="{Binding Model.Fields.Wdif}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wamb" Binding="{Binding Model.Fields.Wamb}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wr" Binding="{Binding Model.Fields.Wr}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wg" Binding="{Binding Model.Fields.Wg}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wb" Binding="{Binding Model.Fields.Wb}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wnr" Binding="{Binding Model.Fields.Wnr}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wfr" Binding="{Binding Model.Fields.Wfr}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wiang" Binding="{Binding Model.Fields.Wiang}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Woang" Binding="{Binding Model.Fields.Woang}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Wax" Binding="{Binding Model.Fields.Wax}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Way" Binding="{Binding Model.Fields.Way}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Waz" Binding="{Binding Model.Fields.Waz}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Lkwkp" Binding="{Binding Model.Fields.Lkwkp.Value, StringFormat=X8}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Exp" Binding="{Binding Model.Fields.Exp.Value, StringFormat=X8}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Light" Binding="{Binding Model.Fields.Light.Value, StringFormat=X8}" FontFamily="Consolas"/>
        </DataGrid.Columns>
    </DataGrid>
</local:View>
