<local:View 
      x:TypeArguments="models:CameraHeaderViewModel, models:CameraHeaderViewModelEntry"
      x:Class="RDXplorer.Views.CameraHeaderView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RDXplorer.Views"
      xmlns:models="clr-namespace:RDXplorer.ViewModels"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=models:CameraHeaderViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Cameras">
    <DataGrid AutoGenerateColumns="False"
              BorderThickness="0"
              CanUserAddRows="False"
              IsReadOnly="True"
              ItemsSource="{Binding Entries}" MouseDoubleClick="DataGrid_MouseDoubleClick">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Position" Binding="{Binding Model.Position, StringFormat=X8}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Flg" Binding="{Binding Model.Fields.Flg}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Type" Binding="{Binding Model.Fields.Type}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="FlrNo" Binding="{Binding Model.Fields.FlrNo}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="CTabN" Binding="{Binding Model.Fields.CTabN}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Cuttp" Binding="{Binding Model.Fields.Cuttp.Value, StringFormat=X8}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Cx" Binding="{Binding Model.Fields.Cx}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Cy" Binding="{Binding Model.Fields.Cy}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Cz" Binding="{Binding Model.Fields.Cz}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Cw" Binding="{Binding Model.Fields.Cw}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Ch" Binding="{Binding Model.Fields.Ch}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Cd" Binding="{Binding Model.Fields.Cd}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Exd" Binding="{Binding Model.Fields.Exd.Value, StringFormat=X8}" FontFamily="Consolas"/>
        </DataGrid.Columns>
    </DataGrid>
</local:View>
