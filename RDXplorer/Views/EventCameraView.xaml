<local:View 
      x:TypeArguments="models:EventCameraViewModel, models:EventCameraViewModelEntry"
      x:Class="RDXplorer.Views.EventCameraView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RDXplorer.Views"
      xmlns:models="clr-namespace:RDXplorer.ViewModels"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=models:EventCameraViewModel}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Event Cameras">
    <DataGrid AutoGenerateColumns="False"
              BorderThickness="0"
              CanUserAddRows="False"
              IsReadOnly="True"
              ItemsSource="{Binding Entries}" MouseDoubleClick="DataGrid_MouseDoubleClick">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Position" Binding="{Binding Model.Position, StringFormat=X8}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Flg" Binding="{Binding Model.Fields.Flg}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="Type" Binding="{Binding Model.Fields.Type}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="NxtNo" Binding="{Binding Model.Fields.NxtNo}" FontFamily="Consolas"/>
            <DataGridTextColumn Header="KeyfN" Binding="{Binding Model.Fields.KeyfN}" FontFamily="Consolas"/>
        </DataGrid.Columns>
    </DataGrid>
</local:View>
